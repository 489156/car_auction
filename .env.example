# ─── Database ──────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to use the bundled PGLite single-file DB at
# ./.data/pglite/. Set it to a real Postgres URL (e.g. Neon, Supabase,
# Vercel Postgres) for production durability across deploys.
#
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ─── Telegram alerts (optional) ───────────────────────────────────────
# AuctionCarRadar can ping a Telegram bot when a new S-Tier match appears.
# The bot token is server-only (never sent to the browser).
#
# Create a bot with @BotFather on Telegram → /newbot → copy the token.
# Get your chat ID by messaging @userinfobot.
#
# TELEGRAM_BOT_TOKEN=123456789:AAH...xyz
# TELEGRAM_CHAT_ID=987654321

# ─── Vercel / production-only ─────────────────────────────────────────
# Vercel injects these automatically; only set them for local prod builds.
#
# VITE_AUTH_ENABLED=false